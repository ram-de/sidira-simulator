# ff-validation-game — production environment template.
# Copy to /etc/ff-validation-game.env on the EC2 host and edit. The systemd
# unit loads this via EnvironmentFile=. NEVER commit a filled-in copy.

# Serve the built dist/ SPA + the API in prod mode (static dist, tight CSP,
# rate limiting on, same-origin CORS lockdown).
NODE_ENV=production

# Port the Node app listens on (loopback/origin port; CloudFront fronts 443).
PORT=5180

# SQLite file. MUST live on the durable EBS volume mounted at /data so a
# stop/start or instance replace does not lose data. Parent dir is created on
# boot. WAL files (ff.db-wal / ff.db-shm) live alongside it.
FF_DB_PATH=/data/ff.db
