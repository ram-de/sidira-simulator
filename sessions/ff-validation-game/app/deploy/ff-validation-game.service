# systemd unit for the ff-validation-game Express app.
# Install to /etc/systemd/system/ff-validation-game.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ff-validation-game
#
# On stop/restart, systemd sends SIGTERM; server/index.js catches it, stops
# accepting connections, then runs a WAL checkpoint(TRUNCATE) + close so no
# committed write is lost (see TimeoutStopSec below — must exceed the app's
# own 10s shutdown guard).

[Unit]
Description=ff-validation-game (Split The Loot) — F&F validation game
After=network-online.target
Wants=network-online.target
# /data is the EBS-backed SQLite mount; don't start until it's mounted.
RequiresMountsFor=/data

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/ff-validation-game
EnvironmentFile=/etc/ff-validation-game.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=2
# Give the graceful checkpoint room to finish (app's internal guard is 10s).
TimeoutStopSec=20
KillSignal=SIGTERM

# Hardening — the app only needs to read its code and write /data.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data
ReadOnlyPaths=/opt/ff-validation-game

[Install]
WantedBy=multi-user.target
