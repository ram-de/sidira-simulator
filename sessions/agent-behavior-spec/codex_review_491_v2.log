    55	              onMouseLeave={() => setHovered(null)}
    56	              style={{
    57	                display: "inline-flex",
    58	                alignItems: "center",
    59	                textDecoration: "none",
    60	                color: hot ? TOKENS.ink : TOKENS.inkMuted,
    61	                fontFamily: FONT_SANS,
    62	                fontSize: 13,
    63	                fontWeight: 500,
    64	                borderBottom: `2px solid ${active ? TOKENS.ink : "transparent"}`,
    65	                // §9.3: hover 80ms ease-out, tab underline 160ms mech curve.
    66	                transition: `color 80ms ease-out, border-bottom-color 160ms ${EASE_MECH}`,
    67	              }}
    68	            >
    69	              {tab.label}
    70	            </Link>
    71	          );
    72	        })}
    73	      </nav>
    74	      <AuthControls />
