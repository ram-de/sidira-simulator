    76	  );
    77	}
     1	// ───────────────────────────────────────────────────────────────────────────
     2	// AppShellV2 — the PRODUCTION v2 application shell (#372).
     3	//
     4	// The static /v2/* mocks render AppFrame with its MOCK defaults (6 href="#" nav
     5	// items + a mock workspace avatar). Production must NOT ship dead nav or fake
     6	// chrome, and must NOT mutate AppFrame's defaults (that would break the mocks).
     7	// So this shell composes the SAME visual frame from the shared v2 layer
     8	// (ConsoleShell scope + the .v2-appframe / .v2-rail* / .v2-appbar classes that
     9	// already live in styles/v2-theme.css and that AppFrame itself consumes) but
    10	// wires the REAL product chrome:
    11	//
    12	//   • exactly the two real destinations the global TopNav exposes —
    13	//     Hypotheses → /simulations (active on /simulations or /agents),
    14	//     Library → /personas — as real Next <Link>s with usePathname() active
    15	//     state. No href="#" dead items.
    16	//   • the rail footer renders the EXISTING AuthControls (Clerk org switcher +
    17	//     user button, or nothing when Clerk is off) — org-switching + sign-out are
    18	//     preserved, never reimplemented here.
    19	//   • title / provenance / actions pass through to the appbar, same as AppFrame.
    20	//
    21	// The whole subtree sits under ConsoleShell's `.v2-console` ancestor, so every
    22	// v2 token resolves. Token-driven only: no raw hex / rgb / font names here.
    23	// ───────────────────────────────────────────────────────────────────────────
    24	"use client";
    25	
    26	import type { ReactNode } from "react";
    27	import Link from "next/link";
    28	import { usePathname } from "next/navigation";
    29	
    30	import AuthControls from "@/components/AuthControls";
    31	import { clerkAppearanceConsole } from "@/lib/clerk";
    32	import { ConsoleShell } from "./ConsoleShell";
    33	// §1.3 (ticket #35): the dual-color mark is the standard mark on every surface,
    34	// in-product nav and dashboard included. The console rail brand mark uses the
