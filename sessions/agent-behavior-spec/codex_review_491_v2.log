    22	  const [hovered, setHovered] = useState<string | null>(null);
    23	
    24	  return (
    25	    <header
    26	      style={{
    27	        height: 56,
    28	        display: "flex",
    29	        alignItems: "center",
    30	        gap: 32,
    31	        padding: "0 24px",
    32	        borderBottom: `1px solid ${TOKENS.rule}`,
    33	        background: TOKENS.paper,
    34	      }}
    35	    >
    36	      <Link
    37	        href="/"
    38	        aria-label="Sidira home"
    39	        style={{ color: TOKENS.ink, textDecoration: "none", display: "inline-flex", alignItems: "center" }}
    40	      >
    41	        <SidiraLockupDuo height={28} />
    42	      </Link>
    43	      <nav style={{ display: "flex", gap: 24, flex: 1, alignSelf: "stretch", alignItems: "stretch" }}>
    44	        {TABS.map((tab) => {
    45	          const active = tab.matches.some(
    46	            (m) => pathname === m || pathname.startsWith(m + "/"),
    47	          );
    48	          const hot = active || hovered === tab.href;
    49	          return (
    50	            <Link
    51	              key={tab.href}
    52	              href={tab.href}
    53	              aria-current={active ? "page" : undefined}
