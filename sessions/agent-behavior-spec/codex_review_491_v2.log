    36	// identically on the dark console ground (no currentColor dependency).
    37	import { SheetMarkDuo } from "./Marks";
    38	import { ProvenanceMarker, type ProvenanceMarkerProps } from "./Provenance";
    39	// The shell owns the v2 stylesheet import so every production v2 page that uses
    40	// it inherits the `.v2-console` tokens + the .v2-appframe/.v2-rail*/.v2-sims-*
    41	// classes (ConsoleShell requires the page to import this sheet).
    42	import "@/styles/v2-theme.css";
    43	
    44	// The two REAL product destinations (kept in lockstep with components/TopNav.tsx
    45	// TABS). `matches` drives active state via usePathname(): Hypotheses owns both
    46	// /simulations and /agents, exactly like the global nav.
    47	const NAV = [
    48	  {
    49	    key: "simulations",
    50	    label: "Hypotheses",
    51	    href: "/simulations",
    52	    glyph: "HYP",
    53	    matches: ["/simulations", "/agents"],
    54	  },
    55	  {
    56	    key: "personas",
    57	    label: "Library",
    58	    href: "/personas",
    59	    glyph: "LIB",
    60	    matches: ["/personas"],
    61	  },
    62	  {
    63	    // Experiment memory (#28, #29) — retrieval over the past-experiment archive.
    64	    key: "memory",
    65	    label: "Memory",
    66	    href: "/memory",
    67	    glyph: "MEM",
    68	    matches: ["/memory"],
    69	  },
    70	] as const;
    71	
    72	export type AppShellV2Props = {
    73	  // which real nav section is current (matches a NAV key). Falls back to
    74	  // pathname matching, but callers pass it explicitly for clarity.
    75	  activeNav?: "simulations" | "personas" | "memory";
    76	  // the page title shown in the appbar.
    77	  title: string;
    78	  // optional right-aligned appbar actions (e.g. the "New hypothesis" CTA).
    79	  actions?: ReactNode;
    80	  // optional single global provenance marker for the appbar.
    81	  provenance?: ProvenanceMarkerProps;
    82	  // content surface. "console" (default) = the dark Reading-Console body, for
    83	  // pages reskinned to the v2 console language. "sheet" = a light reading
    84	  // surface inside the console rail, for pages whose body still renders the
    85	  // legacy ink-on-paper markup (a sanctioned Console-rail + Sheet-content
    86	  // composition). The interim shell-wrap for the dense simulation pages uses
    87	  // "sheet" so their dark-ink content stays legible until a full reskin.
    88	  surface?: "console" | "sheet";
    89	  // the page body.
    90	  children: ReactNode;
    91	};
    92	
    93	export default function AppShellV2({
    94	  activeNav,
    95	  title,
    96	  actions,
    97	  provenance,
    98	  surface = "console",
    99	  children,
   100	}: AppShellV2Props) {
   101	  const pathname = usePathname() ?? "/";
   102	
   103	  return (
   104	    <ConsoleShell>
   105	      <div className="v2-appframe">
   106	        {/* ── LEFT RAIL — persistent vertical nav, real destinations ───────── */}
   107	        <aside className="v2-rail" aria-label="Primary">
   108	          <Link href="/" className="v2-rail-brand" aria-label="Sidira Console home">
   109	            <SheetMarkDuo size={28} />
   110	          </Link>
   111	
   112	          <nav className="v2-rail-nav">
   113	            {NAV.map((item) => {
   114	              const active =
   115	                (activeNav && item.key === activeNav) ||
   116	                item.matches.some(
   117	                  (m) => pathname === m || pathname.startsWith(`${m}/`),
   118	                );
   119	              return (
   120	                <Link
   121	                  key={item.key}
   122	                  href={item.href}
   123	                  className={
   124	                    active ? "v2-rail-item v2-rail-item--active" : "v2-rail-item"
   125	                  }
   126	                  aria-current={active ? "page" : undefined}
   127	                  aria-label={item.label}
   128	                >
   129	                  {/* active = 1px left ink bar (neutral, never signal) */}
   130	                  <span className="v2-rail-bar" aria-hidden />
   131	                  <span className="v2-rail-glyph v2-mono" aria-hidden>
   132	                    {item.glyph}
   133	                  </span>
   134	                  <span className="v2-rail-label">{item.label}</span>
   135	                </Link>
   136	              );
   137	            })}
   138	          </nav>
   139	
   140	          {/* rail footer — the REAL Clerk org switcher + user button (or nothing
   141	              when Clerk is off in dev). Reuses AuthControls verbatim so tenancy
   142	              + sign-out behave identically to the legacy TopNav. Its own
   143	              marginLeft:auto is harmless inside this flex-column footer. */}
   144	          <div className="v2-rail-account-slot">
   145	            <AuthControls appearance={clerkAppearanceConsole} />
   146	          </div>
   147	        </aside>
   148	
   149	        {/* ── CONTENT COLUMN ──────────────────────────────────────────────── */}
   150	        <div className="v2-appframe-content">
   151	          <header className="v2-appbar">
   152	            <h1 className="v2-appbar-title">{title}</h1>
   153	            <div className="v2-appbar-right">
   154	              {provenance ? <ProvenanceMarker {...provenance} /> : null}
   155	              {actions ? <div className="v2-appbar-actions">{actions}</div> : null}
   156	            </div>
   157	          </header>
   158	
   159	          <main
   160	            className={
   161	              surface === "sheet" ? "v2-appmain v2-appmain--sheet" : "v2-appmain"
   162	            }
   163	          >
   164	            {children}
   165	          </main>
   166	        </div>
   167	      </div>
   168	    </ConsoleShell>
   169	  );
   170	}
