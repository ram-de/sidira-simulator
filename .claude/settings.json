{
  "worktree": {
    "bgIsolation": "worktree"
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 300000,
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-save-session.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/filter-bash-output.sh"
          }
        ]
      }
    ]
  }
}
