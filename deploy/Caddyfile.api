api.sidira.ai {
	encode gzip

	@web_proxy path /_sidira_web_proxy/*
	handle @web_proxy {
		basic_auth {
			{$SIDIRA_WEB_PROXY_BASIC_AUTH_USER} {$SIDIRA_WEB_PROXY_BASIC_AUTH_HASH}
		}
		uri strip_prefix /_sidira_web_proxy
		reverse_proxy api:8000 {
			# NOTE: stripping Authorization here blocks the backend Clerk auth
			# gate (SIDIRA_CLERK_SECRET_KEY) from ever seeing a token on this
			# path. Before enabling Clerk in prod, forward the Clerk credential
			# through this proxy (and have the Next middleware send it, #32).
			header_up -Authorization
			header_up X-Sidira-Internal-Key {$SIDIRA_INTERNAL_API_KEY}
		}
	}

	reverse_proxy api:8000
}
