api.sidira.ai {
	encode gzip

	# Web-proxy requests carrying a Clerk session token (#149). The token rides
	# X-Sidira-Clerk-Authorization (a carrier header kept for frontend
	# compatibility); promote it to Authorization for the backend Clerk gate
	# (SIDIRA_CLERK_SECRET_KEY) and drop the carrier header.
	#
	# The pre-launch Basic Auth wall that used to gate this hop was REMOVED: it
	# predated Clerk, and the backend now enforces its own internal-key gate (the
	# anonymous 404-wall, set by X-Sidira-Internal-Key below) + the Clerk session
	# gate, so the outer Basic layer was redundant once Clerk shipped. Removing it
	# also stops the browser-native Basic Auth popup on app.sidira.ai.
	@web_proxy_clerk {
		path /_sidira_web_proxy/*
		header X-Sidira-Clerk-Authorization *
	}
	handle @web_proxy_clerk {
		uri strip_prefix /_sidira_web_proxy
		reverse_proxy api:8000 {
			header_up Authorization {http.request.header.X-Sidira-Clerk-Authorization}
			header_up -X-Sidira-Clerk-Authorization
			header_up X-Sidira-Internal-Key {$SIDIRA_INTERNAL_API_KEY}
		}
	}

	# Tokenless web-proxy requests (pre-Clerk fallback path): strip any
	# Authorization so the backend never sees a stale credential. With the backend
	# Clerk gate enabled these requests 401 on protected routes — by design.
	@web_proxy path /_sidira_web_proxy/*
	handle @web_proxy {
		uri strip_prefix /_sidira_web_proxy
		reverse_proxy api:8000 {
			header_up -Authorization
			header_up X-Sidira-Internal-Key {$SIDIRA_INTERNAL_API_KEY}
		}
	}

	reverse_proxy api:8000
}
