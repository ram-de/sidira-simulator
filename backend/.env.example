# Sidira backend local development
#
# SIDIRA_* is the canonical simulator config namespace. Legacy PYTHIA_* names
# are still accepted as fallbacks during the pre-launch rename; if both are set,
# SIDIRA_* wins.

SIDIRA_CUSTOMER_ID=demo
SIDIRA_LOCAL_ARTIFACTS=../local-artifacts
SIDIRA_MAX_AGENTS=50
# Local dev origins. For production, set this in the deploy environment to:
# https://sidira.ai,https://app.sidira.ai
SIDIRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local credential encryption for Persona Builder development.
# Generate a key with:
# python -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
SIDIRA_CRED_MODE=local
SIDIRA_LOCAL_CRED_KEY=
# Optional temporary API gate. Production sets this via Parameter Store.
SIDIRA_INTERNAL_API_KEY=

# Clerk session auth (Phase 5). When SIDIRA_CLERK_SECRET_KEY is unset, the auth
# gate is disabled and the API trusts SIDIRA_CUSTOMER_ID — the local-dev / test
# default. Set the secret (and the comma-separated authorized parties) in the
# deploy environment to enforce per-request Clerk session validation.
#
# The forwarding path shipped with #149: the Next proxy sends the Clerk token
# as X-Sidira-Clerk-Authorization and deploy/Caddyfile.api promotes it to
# Authorization for this gate. WARNING: set this secret in prod ONLY together
# with the Amplify Clerk keys (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY +
# CLERK_SECRET_KEY) — with the secret on but no signed-in frontend sending
# tokens, all app traffic 401s. One coherent cutover, both sides at once.
SIDIRA_CLERK_SECRET_KEY=
# SIDIRA_CLERK_AUTHORIZED_PARTIES=https://sidira.ai,https://app.sidira.ai

# Clerk webhook signing secret (whsec_…) for POST /webhooks/clerk, which
# provisions a customer (tenant) row from each organization.created event.
# Independent of the session gate above: the endpoint is public but verifies the
# Svix signature on every delivery, so it is safe to enable in prod on its own.
# When unset the endpoint returns 503 (refuses to act on unverifiable deliveries).
SIDIRA_CLERK_WEBHOOK_SECRET=

# Provider API keys. Configure at least one for live simulations.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional runtime infrastructure.
# DATABASE_URL=
# SIDIRA_AUTO_MIGRATE=1
# R2_BUCKET=
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
