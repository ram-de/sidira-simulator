# Sidira backend local development
#
# SIDIRA_* is the canonical simulator config namespace. Legacy PYTHIA_* names
# are still accepted as fallbacks during the pre-launch rename; if both are set,
# SIDIRA_* wins.

SIDIRA_CUSTOMER_ID=demo
SIDIRA_LOCAL_ARTIFACTS=../local-artifacts
SIDIRA_MAX_AGENTS=50
# Local dev origins. For production, set this in the deploy environment to:
# https://sidira.ai,https://app.sidira.ai
SIDIRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local credential encryption for Persona Builder development.
# Generate a key with:
# python -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
SIDIRA_CRED_MODE=local
SIDIRA_LOCAL_CRED_KEY=

# Provider API keys. Configure at least one for live simulations.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional runtime infrastructure.
# DATABASE_URL=
# SIDIRA_AUTO_MIGRATE=1
# R2_BUCKET=
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
