# Sidira frontend local development and production proxy config
#
# Browser code defaults to the same-origin /api proxy when NEXT_PUBLIC_API_BASE
# is unset. The proxy forwards to SIDIRA_API_BASE_INTERNAL. In production,
# Amplify strips the browser Basic Auth header before the SSR route sees it, so
# the server-side route may use SIDIRA_WEB_PROXY_BASIC_AUTH to authenticate to
# the EC2/Caddy runtime proxy. Backend gateway auth is added by Caddy, not by
# Amplify or Next.

# Local dev through the Next proxy:
SIDIRA_API_BASE_INTERNAL=http://127.0.0.1:8000

# Optional: direct local browser-to-backend calls, bypassing the proxy.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Production:
# SIDIRA_API_BASE_INTERNAL=https://api.sidira.ai/_sidira_web_proxy
# SIDIRA_WEB_PROXY_BASIC_AUTH=<base64 sidira:<Amplify access-control password>>
