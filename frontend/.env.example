# Sidira frontend local development and production proxy config
#
# Browser code defaults to the same-origin /api proxy when NEXT_PUBLIC_API_BASE
# is unset. The proxy forwards to SIDIRA_API_BASE_INTERNAL. In production,
# Amplify strips the browser Basic Auth header before the SSR route sees it, so
# the server-side route may use SIDIRA_WEB_PROXY_BASIC_AUTH to authenticate to
# the EC2/Caddy runtime proxy. Backend gateway auth is added by Caddy, not by
# Amplify or Next.

# Local dev through the Next proxy:
SIDIRA_API_BASE_INTERNAL=http://127.0.0.1:8000

# Optional: direct local browser-to-backend calls, bypassing the proxy.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Production:
# SIDIRA_API_BASE_INTERNAL=https://api.sidira.ai/_sidira_web_proxy
# SIDIRA_WEB_PROXY_BASIC_AUTH=<base64 sidira:<Amplify access-control password>>

# Clerk authentication (#32).
# When NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is unset, the app runs without Clerk:
# the auth pages show an "unavailable" notice and the middleware keeps the
# temporary app-host Basic-Auth gate above. Set the publishable + secret keys
# together to enable Clerk sign-in/up and route protection.
#
# Tenancy = Clerk Organization: the "Organizations" feature MUST be enabled in
# the Clerk dashboard so sign-up can create an org. That organization.created
# event is what #31's webhook turns into a provisioned customer.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
#
# Optional — defaults already match the app's routes, override only if you move them:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
